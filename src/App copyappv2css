/*LABEL: Maps */
.map-wrapper {
  /* flex-1: Allows the element to grow and shrink, taking up available space */
  flex: 1 1 0%;
  
  /* relative: Sets the positioning context for absolute children */
  position: relative;
  
  /* bg-slate-950: Tailwind's specific dark slate hex code */
  background-color: #020617;
}

/* Important: Leaflet maps need a defined height to appear */
.map-wrapper .leaflet-container {
  height: 100%;
  width: 100%;
}

