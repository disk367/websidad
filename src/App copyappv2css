/* Container pembungkus di pojok kanan atas */
.map-controls-container {
  position: absolute;
  top: 1.5rem;          /* top-6: 6 * 0.25rem = 1.5rem atau 24px */
  right: 1.5rem;        /* right-6: 1.5rem atau 24px */
  z-index: 1001;        /* z-[1001] */
  display: flex;
  flex-direction: column; /* flex-col */
  gap: 0.75rem;         /* gap-3: 3 * 0.25rem = 0.75rem atau 12px */
}

/* Styling Tombol Google Maps */
.btn-google-maps {
  background-color: #06b6d4; /* bg-cyan-500 */
  color: #000000;            /* text-black */
  padding: 0.75rem 1.5rem;   /* py-3 (12px) px-6 (24px) */
  border-radius: 1rem;       /* rounded-2xl: 16px */
  font-size: 10px;           /* text-[10px] */
  font-weight: 900;          /* font-black */
  text-transform: uppercase; /* uppercase */
  transition: all 0.15s ease; /* transition-all */
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); /* shadow-2xl */
  border: none;              /* reset default button border */
  cursor: pointer;
}

/* Efek Hover */
.btn-google-maps:hover {
  background-color: #22d3ee; /* hover:bg-cyan-400 */
}
